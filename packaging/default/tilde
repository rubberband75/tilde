# Options for "tilde serve" (installed as /etc/default/tilde).
#
# Tilde listens on localhost only by default. To reach it from other
# machines, prefer a VPN address (Tailscale, WireGuard) or a LAN address
# over exposing it to the internet:
#   TILDE_OPTS="--listen 100.101.102.103:8443"
#
# Use your own certificate instead of the self-signed one:
#   TILDE_OPTS="--listen 0.0.0.0:8443 --tls-cert /etc/tilde/cert.pem --tls-key /etc/tilde/key.pem"
#
# Local web apps (Jupyter, code-server) open from the port after --listen's
# (8444 here), and host apps through Xpra from the one after that (8445),
# each another origin; open all three in a firewall. To move or turn them off:
#   TILDE_OPTS="--listen 127.0.0.1:8443 --apps-listen 127.0.0.1:9000 --xpra-listen 127.0.0.1:9001"
#   TILDE_OPTS="--listen 127.0.0.1:8443 --xpra-listen off"
#   TILDE_OPTS="--listen 127.0.0.1:8443 --apps-listen off"   (both off)
# Behind a reverse proxy, give the addresses browsers reach them at:
#   --apps-origin https://apps.example.com --xpra-origin https://xpra.example.com
#
# A login lasts 12 hours, however active, then asks for the password again
# (idle browsers lock sooner, as each user sets). To change it:
#   TILDE_OPTS="--listen 127.0.0.1:8443 --session-lifetime 8h"
TILDE_OPTS="--listen 127.0.0.1:8443"
